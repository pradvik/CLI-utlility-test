# Source Qualtrics account (variable names only — no real secrets)
QUALTRICS_SOURCE_BASE_URL=https://<source-datacenter>.qualtrics.com/API/v3
QUALTRICS_SOURCE_API_TOKEN=

# Destination Qualtrics account
QUALTRICS_DEST_BASE_URL=https://<destination-datacenter>.qualtrics.com/API/v3
QUALTRICS_DEST_API_TOKEN=

# Paths and runtime
MIGRATION_STATE_DB=./state/migrations.sqlite
MIGRATION_REPORT_DIR=./reports
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60
IMPORT_POLL_INTERVAL_SECONDS=5
IMPORT_MAX_WAIT_SECONDS=1800
DRY_RUN_DEFAULT=true
